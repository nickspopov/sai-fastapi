# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sai
SQL_ECHO=false

# Authentication
# Set SKIP_AUTH=true for local development without Firebase
SKIP_AUTH=false
# Required when SKIP_AUTH=true - the email of the user to authenticate as
DEFAULT_DEV_USER_EMAIL=

# Firebase
# Path to Firebase service account credentials JSON file
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
